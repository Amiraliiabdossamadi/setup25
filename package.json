{
  "name": "cafenet-maxnet",
  "productName": "MaxNet",
  "version": "1.0.0",
  "description": "MaxNet",
  "author": "MaxNet",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "ir.maxnet.app",
    "productName": "MaxNet",
    "files": [
      "main.js",
      "preload.js",
      "app/**",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "مکسنت",
      "runAfterFinish": true,
      "language": "1065",
      "deleteAppDataOnUninstall": false,
      "artifactName": "MaxNet-Setup.exe",
      "uninstallDisplayName": "مکسنت",
      "license": "build/license.txt",
      "menuCategory": false
    },
    "asar": true
  }
}